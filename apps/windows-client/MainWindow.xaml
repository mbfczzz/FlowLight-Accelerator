<Window x:Class="FlowLight.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="流光加速器 · FlowLight Accelerator" Width="1120" Height="750" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <!-- Sidebar: wordmark, actions, account. -->
  <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"><DockPanel Margin="18,26,18,18">
   <StackPanel DockPanel.Dock="Top">
    <StackPanel Orientation="Horizontal" Margin="10,0,0,0"><Path Data="M 0 1 L 16 1 L 13 3.2 L 2 3.2 Z M 4 6 L 22 6 L 19 8.2 L 6 8.2 Z M 0 11 L 12 11 L 9 13.2 L 2 13.2 Z" Fill="{StaticResource Accent}" Width="22" Height="14" VerticalAlignment="Center"/><TextBlock Text="流光加速器" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
    <TextBlock Text="FLOWLIGHT ACCELERATOR" FontFamily="{StaticResource DataFont}" FontSize="10" Foreground="{StaticResource TextTertiary}" Margin="42,2,0,0"/>
    <TextBlock Text="操作" Style="{StaticResource Caption}" Margin="10,34,0,8"/>
    <Button x:Name="RefreshButton" Content="刷新游戏与线路" Style="{StaticResource Ghost}" Click="Refresh_Click"/>
    <Button Content="连接诊断" Style="{StaticResource Ghost}" Margin="0,2,0,0" Click="Diagnostics_Click"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom">
    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,16,10,10"><StackPanel><TextBlock Text="当前账号" Style="{StaticResource Caption}"/><TextBlock x:Name="AccountLabel" Text="尚未登录" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    <Button x:Name="AccountButton" Content="账号登录" Style="{StaticResource Ghost}" Click="Account_Click"/>
    <Button x:Name="LogoutButton" Content="退出登录" Style="{StaticResource Ghost}" Visibility="Collapsed" Margin="0,2,0,0" Click="Logout_Click"/>
    <Button Content="退出并停止加速" Style="{StaticResource Ghost}" Margin="0,2,0,0" Click="Exit_Click"/>
    <TextBlock x:Name="VersionLabel" Text="Windows x64" Style="{StaticResource Caption}" FontFamily="{StaticResource DataFont}" Margin="10,18,0,0"/>
   </StackPanel>
   <Grid/>
  </DockPanel></Border>

  <Grid Grid.Column="1" Margin="28,24,28,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <!-- Header: title plus the local-service pill. -->
   <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="我的游戏" Style="{StaticResource PageTitle}"/><TextBlock x:Name="GameCount" Text="" Style="{StaticResource Meta}" Margin="10,0,0,0" VerticalAlignment="Bottom" Padding="0,0,0,3"/></StackPanel>
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="999" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ServiceDot" Width="7" Height="7" Fill="{StaticResource TextTertiary}" VerticalAlignment="Center"/><TextBlock x:Name="ServiceLabel" Text="检测本地服务…" Style="{StaticResource Meta}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></Border></Grid>

   <!-- Notice banner: a severity stripe says what kind of message it is before the text is read. -->
   <Border Grid.Row="1" x:Name="NoticeBox" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="NoticeStripe" Width="3" Background="{StaticResource Info}" CornerRadius="4,0,0,4"/><TextBlock Grid.Column="1" x:Name="Notice" Text="请登录后查看游戏与线路。首次使用需要安装本地服务。" TextWrapping="Wrap" FontSize="12.5" Margin="14,10,14,10"/></Grid></Border>

   <Grid Grid.Row="2" Margin="0,18,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,24,0">
     <ListBox x:Name="GameList" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="Game_Changed" HorizontalContentAlignment="Stretch">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=Window}}"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="card" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="5" Padding="16,14" SnapsToDevicePixels="True"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Background" Value="{StaticResource Elevated}"/><Setter TargetName="card" Property="BorderBrush" Value="{StaticResource BorderStrong}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="card" Property="Background" Value="{StaticResource AccentSoft}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel MinHeight="64"><Grid><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,70,0"/><TextBlock Text="{Binding RuleLabel}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><ItemsControl ItemsSource="{Binding RegionLabels}" Margin="0,10,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource Elevated}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="0,0,6,4"><TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextSecondary}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="EmptyGames" VerticalAlignment="Top" IsHitTestVisible="False" Text="登录后将从服务端加载游戏目录。" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="2,4,0,0"/>
    </Grid>

    <!-- Connection panel: what will be connected, the evidence, and the one primary action. -->
    <Border Grid.Column="1" VerticalAlignment="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="20,18"><DockPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><Button x:Name="StartButton" Content="开始加速" Style="{StaticResource Primary}" IsEnabled="False" Click="Start_Click"/><Button x:Name="StopButton" Content="停止加速" IsEnabled="False" Margin="0,8,0,0" Click="Stop_Click"/></StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <TextBlock Text="本次连接" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="游戏区服" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
      <ComboBox x:Name="RegionList" SelectionChanged="Region_Changed"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <TextBlock Text="加速线路" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
      <ComboBox x:Name="LineList" SelectionChanged="Line_Changed"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Opacity="{Binding Dim}"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Tag}" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <TextBlock x:Name="LineHint" Text="请选择游戏与区服" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0"><StackPanel>
       <TextBlock x:Name="ProbeTitle" Text="线路历史探测" Style="{StaticResource Caption}"/>
       <TextBlock x:Name="Latency" Text="—" FontFamily="{StaticResource DataFont}" FontSize="34" Margin="0,2,0,0"/>
       <TextBlock Text="此数值不等同于游戏内延迟" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
    </DockPanel></Border>
   </Grid>

   <!-- Status strip. -->
   <Border Grid.Row="3" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,14,0,0"><Grid><StackPanel Orientation="Horizontal"><Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{StaticResource TextTertiary}" VerticalAlignment="Center"/><TextBlock x:Name="ConnectionState" Text="未连接" Style="{StaticResource Meta}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="ExitAddress" Text="游戏与线路由服务端配置" Style="{StaticResource Caption}" FontFamily="{StaticResource DataFont}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
  </Grid>

  <!-- Sign-in dialog. -->
  <Border x:Name="LoginOverlay" Grid.ColumnSpan="2" Background="#D9131217" Visibility="Collapsed">
   <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="6" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,26,28,24"><StackPanel>
    <StackPanel Orientation="Horizontal"><Path Data="M 0 1 L 16 1 L 13 3.2 L 2 3.2 Z M 4 6 L 22 6 L 19 8.2 L 6 8.2 Z M 0 11 L 12 11 L 9 13.2 L 2 13.2 Z" Fill="{StaticResource Accent}" Width="22" Height="14" VerticalAlignment="Center"/><TextBlock Text="流光加速器" Style="{StaticResource Meta}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
    <TextBlock x:Name="LoginTitle" Text="登录" Style="{StaticResource PageTitle}" Margin="0,16,0,0"/>
    <TextBlock x:Name="LoginSubtitle" Text="使用平台账号获取游戏与线路授权。" Style="{StaticResource Meta}" Margin="0,6,0,22"/>
    <TextBlock Text="账号" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Username" AutomationProperties.Name="账号"/>
    <TextBlock Text="密码" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/><PasswordBox x:Name="Password" AutomationProperties.Name="密码"/>
    <TextBlock x:Name="LoginError" TextWrapping="Wrap" Foreground="{StaticResource Bad}" FontSize="12" Margin="0,10,0,0"/>
    <Button x:Name="LoginButton" Content="登录" Style="{StaticResource Primary}" IsDefault="True" Margin="0,18,0,0" Click="Login_Click"/>
    <Button Content="返回" Style="{StaticResource Ghost}" HorizontalContentAlignment="Center" IsCancel="True" Margin="0,6,0,0" Click="LoginCancel_Click"/>
    <TextBlock Text="还没有账号？账号由运营方在后台开通，请联系客服获取；客户端不提供自助注册。" Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"/>
   </StackPanel></Border>
  </Border>
 </Grid>
</Window>
