<Window x:Class="FlowLight.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FlowLight.Client" Title="流光加速器" Width="1120" Height="750" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource Text}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <local:MatchVisibility x:Key="Match"/>
  <local:OtherRunning x:Key="OtherRunning"/>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <!-- Rail: brand, the two places, the account. -->
  <Border Background="{StaticResource Sidebar}">
   <DockPanel Margin="0,20,0,18">
    <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
     <Path Data="{StaticResource BrandMark}" Fill="{StaticResource Accent}" Width="30" Height="19" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,2,0,26"/>
     <RadioButton x:Name="NavLibrary" Style="{StaticResource NavItem}" IsChecked="True" AutomationProperties.Name="游戏库" Checked="NavLibrary_Checked">
      <StackPanel><local:Glyph Data="{StaticResource IconGrid}" IconSize="22" HorizontalAlignment="Center" Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="游戏库" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
     </RadioButton>
     <RadioButton x:Name="NavGame" Style="{StaticResource NavItem}" Margin="0,8,0,0" IsEnabled="False" AutomationProperties.Name="加速" Checked="NavGame_Checked">
      <Grid><StackPanel><local:Glyph Data="{StaticResource IconBolt}" IconSize="22" HorizontalAlignment="Center" Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Text="加速" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       <Ellipse x:Name="NavRunningDot" Width="8" Height="8" Fill="{StaticResource Good}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-9,0" Visibility="Collapsed"/></Grid>
     </RadioButton>
    </StackPanel>
    <Button DockPanel.Dock="Bottom" x:Name="AvatarButton" Style="{StaticResource AvatarButton}" AutomationProperties.Name="账号" ToolTip="登录账号" HorizontalAlignment="Center" Click="Avatar_Click">
     <Grid><TextBlock x:Name="AvatarInitial" Text="" FontFamily="{StaticResource DataFont}" FontSize="15" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/><local:Glyph x:Name="AvatarGlyph" Data="{StaticResource IconUser}" IconSize="18" Ink="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
    </Button>
    <Grid/>
   </DockPanel>
  </Border>

  <Grid Grid.Column="1">

   <!-- Library: cover cards. -->
   <Grid x:Name="LibraryPage" MaxWidth="1320">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="32,26,32,0">
     <TextBlock Text="游戏库" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Grid Width="260"><TextBox x:Name="SearchBox" AutomationProperties.Name="搜索游戏" KeyDown="SearchBox_KeyDown" FontSize="13" Padding="36,0,10,0"/><local:Glyph Data="{StaticResource IconSearch}" IconSize="17" Ink="{StaticResource TextTertiary}" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock Text="搜索游戏" Style="{StaticResource SearchPlaceholder}" Margin="37,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
      <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Margin="8,0,0,0" Height="40" Width="40" AutomationProperties.Name="刷新游戏与线路" ToolTip="刷新游戏与线路" Click="Refresh_Click"><local:Glyph Data="{StaticResource IconRefresh}" IconSize="19" Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     </StackPanel>
    </Grid>
    <!-- A newer client published in the admin: downloaded, checked and installed in place. -->
    <Border Grid.Row="1" x:Name="UpdateBar" Style="{StaticResource Panel}" Margin="32,20,32,0" Padding="14,12" Visibility="Collapsed">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentSoft}" VerticalAlignment="Center"><local:Glyph Data="{StaticResource IconDownload}" IconSize="20" Ink="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
       <TextBlock x:Name="UpdateTitle" Text="" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="UpdateDetail" Text="" Style="{StaticResource Meta}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
       <Grid x:Name="UpdateTrack" Height="4" Margin="0,9,0,0" Visibility="Collapsed"><Border Background="{StaticResource Elevated}" CornerRadius="2"/><Border x:Name="UpdateFill" Background="{StaticResource Accent}" CornerRadius="2" HorizontalAlignment="Left" Width="0"/></Grid>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
       <Button x:Name="UpdateLater" Content="稍后" MinWidth="72" Margin="0,0,8,0" Click="UpdateLater_Click"/>
       <Button x:Name="UpdateNow" Style="{StaticResource Primary}" Content="立即更新" MinWidth="112" MinHeight="38" Padding="16,0" Click="UpdateNow_Click"/>
      </StackPanel>
     </Grid>
    </Border>
    <Border Grid.Row="2" x:Name="RunningBanner" Style="{StaticResource Panel}" Margin="32,20,32,0" Padding="10" Visibility="Collapsed">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <local:GameCover x:Name="BannerCover" Width="112" Height="63" Radius="8"/>
      <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource Good}" VerticalAlignment="Center"/><TextBlock x:Name="BannerTitle" Text="" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
       <TextBlock x:Name="BannerDetail" Text="" Style="{StaticResource Meta}" Margin="16,5,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock x:Name="BannerLatency" Text="—" Style="{StaticResource Number}" FontSize="26"/><TextBlock Text="ms" Style="{StaticResource Caption}" Margin="4,0,0,4" VerticalAlignment="Bottom"/></StackPanel>
      <Button Grid.Column="3" Content="查看" MinWidth="88" Click="OpenRunning_Click"/>
     </Grid>
    </Border>
    <Grid Grid.Row="3" Margin="32,20,16,0">
     <ListBox x:Name="GameList" AutomationProperties.Name="游戏列表" SelectionChanged="Game_Changed" PreviewKeyDown="GameList_PreviewKeyDown" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=Window}}"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,16,16"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="GameCard_Down"/><EventSetter Event="PreviewMouseLeftButtonUp" Handler="GameCard_Click"/><EventSetter Event="KeyDown" Handler="GameCard_Key"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
         <Border x:Name="card" Background="{StaticResource Surface}" CornerRadius="12" Padding="8"><ContentPresenter/></Border>
         <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Background" Value="{StaticResource Elevated}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource OtherRunning}"><Binding Path="ID"/><Binding Path="RunningGameID" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></DataTrigger.Binding><Setter Property="Opacity" Value=".55"/></DataTrigger></Style.Triggers>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel>
       <Grid Height="{Binding CoverHeight, RelativeSource={RelativeSource AncestorType=Window}}">
        <local:GameCover Seed="{Binding ID}" Monogram="{Binding Initial}" Hue="{Binding Hue}" Art="{Binding Art}" Radius="8"/>
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="{StaticResource Scrim}" CornerRadius="5" Padding="7,2">
         <Border.Visibility><MultiBinding Converter="{StaticResource Match}"><Binding Path="ID"/><Binding Path="LastGameID" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></Border.Visibility>
         <TextBlock Text="上次加速" FontSize="11" Foreground="White"/></Border>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Background="{StaticResource Good}" CornerRadius="5" Padding="6,2,8,2">
         <Border.Visibility><MultiBinding Converter="{StaticResource Match}"><Binding Path="ID"/><Binding Path="RunningGameID" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></Border.Visibility>
         <StackPanel Orientation="Horizontal"><local:Glyph Data="{StaticResource IconBolt}" Filled="True" IconSize="12" Ink="#0E2A1B" VerticalAlignment="Center"/><TextBlock Text="加速中" FontSize="11" FontWeight="SemiBold" Foreground="#0E2A1B" Margin="3,0,0,0"/></StackPanel></Border>
        <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Effect="{StaticResource Shadow}">
         <Border.Style><Style TargetType="Border"><Setter Property="Opacity" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers></Style></Border.Style>
         <local:Glyph Data="{StaticResource IconBolt}" Filled="True" IconSize="19" Ink="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       </Grid>
       <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="6,12,6,0" TextTrimming="CharacterEllipsis"/>
       <StackPanel Orientation="Horizontal" Margin="6,6,6,6"><local:Glyph Data="{StaticResource IconPin}" IconSize="13" Ink="{StaticResource TextTertiary}" VerticalAlignment="Center"/><TextBlock Text="{Binding RegionLabel}" Style="{StaticResource Caption}" Margin="5,0,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel x:Name="SearchEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,16,80" Visibility="Collapsed">
      <Grid Width="104" Height="104" HorizontalAlignment="Center"><Ellipse Fill="{StaticResource Surface}"/><Ellipse Margin="13" Stroke="{StaticResource Border}" StrokeThickness="1.5"/><local:Glyph Data="{StaticResource IconSearch}" IconSize="38" Thickness="1.6" Ink="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      <TextBlock x:Name="SearchEmptyTitle" Text="" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" Margin="0,18,0,0" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
      <TextBlock Text="换个关键词试试，或清除搜索查看全部游戏。" Style="{StaticResource Meta}" TextAlignment="Center" Margin="0,6,0,0"/>
      <Button Content="清除搜索" MinWidth="120" HorizontalAlignment="Center" Margin="0,18,0,0" Click="ClearSearch_Click"/>
     </StackPanel>
    </Grid>
   </Grid>

   <!-- Game: banner, choices, the dial, the live session. -->
   <Grid x:Name="GamePage" Visibility="Collapsed" MaxWidth="1320">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Height="184" Margin="24,20,24,0">
     <local:GameCover x:Name="HeroCover" Radius="14" Shade="True" FullArt="True"/>
     <Button Style="{StaticResource OnArt}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" AutomationProperties.Name="返回游戏库" Click="Back_Click"><StackPanel Orientation="Horizontal"><local:Glyph Data="{StaticResource IconBack}" IconSize="15" Thickness="2.2" Ink="White" VerticalAlignment="Center"/><TextBlock Text="游戏库" FontSize="12.5" Foreground="White" Margin="4,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
     <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="28,0,200,22">
      <TextBlock x:Name="HeroTitle" Text="" FontSize="30" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
      <ItemsControl x:Name="HeroRegions" Margin="0,10,0,0">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource Scrim}" CornerRadius="5" Padding="8,3" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Code}" Style="{StaticResource Number}" FontSize="11" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" FontSize="12" Foreground="White" Margin="5,0,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
     <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,24" Background="#B30D0C10" CornerRadius="16" Padding="12,6,14,6"><StackPanel Orientation="Horizontal"><Ellipse x:Name="HeroDot" Width="8" Height="8" Fill="{StaticResource TextTertiary}" VerticalAlignment="Center"/><TextBlock x:Name="HeroStatus" Text="未加速" FontSize="13" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Border>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid Margin="24,20,24,24">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="316"/></Grid.ColumnDefinitions>

      <StackPanel x:Name="Selectors">
       <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><local:Glyph Data="{StaticResource IconPin}" IconSize="17" Ink="{StaticResource Accent}" VerticalAlignment="Center"/><TextBlock Text="选择区服" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
       <ListBox x:Name="RegionList" Style="{StaticResource FlatList}" AutomationProperties.Name="区服" ItemContainerStyle="{StaticResource RegionTile}" SelectionChanged="Region_Changed" Margin="0,6,0,0">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Width="36" Height="36" CornerRadius="8" Background="{Binding Badge}"><TextBlock Text="{Binding Code}" Style="{StaticResource Number}" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
         <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <Grid Margin="0,16,0,12"><StackPanel Orientation="Horizontal"><local:Glyph Data="{StaticResource IconRoute}" IconSize="17" Ink="{StaticResource Accent}" VerticalAlignment="Center"/><TextBlock Text="选择线路" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="延迟为线路历史检测值" Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button x:Name="LinesRefreshButton" Style="{StaticResource IconButton}" Width="30" Height="30" MinHeight="30" Margin="6,-6,-6,-6" AutomationProperties.Name="刷新线路" ToolTip="刷新线路" Click="RefreshLines_Click"><local:Glyph Data="{StaticResource IconRefresh}" IconSize="15" Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button></StackPanel></Grid>
       <ListBox x:Name="LineList" Style="{StaticResource FlatList}" AutomationProperties.Name="线路" ItemContainerStyle="{StaticResource LineRow}" SelectionChanged="Line_Changed">
        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <local:SignalBars Level="{Binding Bars}" Ink="{Binding QualityBrush}" VerticalAlignment="Center"/>
         <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Border Background="{StaticResource AccentSoft}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding RecommendedVisibility}"><TextBlock Text="推荐" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/></Border></StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Ellipse Width="6" Height="6" Fill="{Binding LoadBrush}" VerticalAlignment="Center" Visibility="{Binding LoadVisibility}"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="5,0,0,0"/></StackPanel>
         </StackPanel>
         <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding RttText}" Style="{StaticResource Number}" FontSize="19" Foreground="{Binding QualityBrush}"/><TextBlock Text="{Binding RttUnit}" Style="{StaticResource Caption}" Margin="3,0,0,3" VerticalAlignment="Bottom"/></StackPanel>
        </Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock x:Name="LineHint" Text="" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="2,4,0,0"/>
      </StackPanel>

      <StackPanel x:Name="Dashboard" Visibility="Collapsed">
       <UniformGrid x:Name="StatGrid" Columns="4" Margin="-5,0,-5,0">
        <Border Style="{StaticResource Tile}" Margin="5"><StackPanel>
         <StackPanel Orientation="Horizontal"><Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource GoodSoft}"><local:Glyph Data="{StaticResource IconGauge}" IconSize="16" Ink="{StaticResource Good}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="延迟" Style="{StaticResource Meta}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock x:Name="StatLatency" AutomationProperties.AutomationId="StatLatency" Text="—" Style="{StaticResource Number}" FontSize="26"/><TextBlock Text="ms" Style="{StaticResource Caption}" Margin="4,0,0,4" VerticalAlignment="Bottom"/></StackPanel></StackPanel></Border>
        <Border Style="{StaticResource Tile}" Margin="5"><StackPanel>
         <StackPanel Orientation="Horizontal"><Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource InfoSoft}"><local:Glyph Data="{StaticResource IconWave}" IconSize="16" Ink="{StaticResource Info}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="抖动" Style="{StaticResource Meta}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock x:Name="StatJitter" Text="—" Style="{StaticResource Number}" FontSize="26"/><TextBlock Text="ms" Style="{StaticResource Caption}" Margin="4,0,0,4" VerticalAlignment="Bottom"/></StackPanel></StackPanel></Border>
        <Border Style="{StaticResource Tile}" Margin="5"><StackPanel>
         <StackPanel Orientation="Horizontal"><Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource WarnSoft}"><local:Glyph Data="{StaticResource IconPacket}" IconSize="16" Ink="{StaticResource Warn}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="丢包" Style="{StaticResource Meta}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock x:Name="StatLoss" Text="—" Style="{StaticResource Number}" FontSize="26"/><TextBlock x:Name="StatLossUnit" Text="%" Style="{StaticResource Caption}" Margin="4,0,0,4" VerticalAlignment="Bottom"/></StackPanel></StackPanel></Border>
        <Border Style="{StaticResource Tile}" Margin="5"><StackPanel>
         <StackPanel Orientation="Horizontal"><Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentSoft}"><local:Glyph Data="{StaticResource IconClock}" IconSize="16" Ink="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="已加速" Style="{StaticResource Meta}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
         <TextBlock x:Name="StatElapsed" Text="—" Style="{StaticResource Number}" FontSize="26" Margin="0,12,0,0"/></StackPanel></Border>
       </UniformGrid>
       <Border Style="{StaticResource Panel}" Margin="0,10,0,0" Padding="18,16,18,12"><StackPanel>
        <Grid><TextBlock Text="延迟走势" Style="{StaticResource SectionTitle}"/><TextBlock Text="当前隧道检测，约每 30 秒一次" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        <local:LatencyChart x:Name="Chart" Height="170" Margin="0,12,0,0"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Panel}" Margin="0,10,0,0" Padding="18,14"><WrapPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2,28,2"><local:Glyph Data="{StaticResource IconRoute}" IconSize="16" Ink="{StaticResource TextTertiary}" VerticalAlignment="Center"/><TextBlock Text="线路" Style="{StaticResource Caption}" Margin="7,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="DashLine" Text="—" FontSize="13" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2,28,2"><local:Glyph Data="{StaticResource IconPin}" IconSize="16" Ink="{StaticResource TextTertiary}" VerticalAlignment="Center"/><TextBlock Text="区服" Style="{StaticResource Caption}" Margin="7,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="DashRegion" Text="—" FontSize="13" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,2"><local:Glyph Data="{StaticResource IconGlobe}" IconSize="16" Ink="{StaticResource TextTertiary}" VerticalAlignment="Center"/><TextBlock Text="出口 IP" Style="{StaticResource Caption}" Margin="7,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="DashExit" Text="—" Style="{StaticResource Number}" FontSize="13" VerticalAlignment="Center"/></StackPanel>
       </WrapPanel></Border>
      </StackPanel>

      <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="24,26,24,22" VerticalAlignment="Top"><StackPanel>
       <Grid Width="208" Height="208" HorizontalAlignment="Center">
        <Ellipse x:Name="DialGlow" Margin="30" Fill="{StaticResource Accent}" Opacity="0" IsHitTestVisible="False"><Ellipse.Effect><BlurEffect Radius="44"/></Ellipse.Effect></Ellipse>
        <Ellipse x:Name="DialTrack" Margin="4" Stroke="{StaticResource Border}" StrokeThickness="6" IsHitTestVisible="False"/>
        <Canvas Width="200" Height="200" IsHitTestVisible="False"><Path x:Name="DialComet" Data="M100,3 A97,97 0 0 1 195.53,83.16" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"><Path.RenderTransform><RotateTransform x:Name="CometSpin" CenterX="100" CenterY="100"/></Path.RenderTransform></Path></Canvas>
        <Button x:Name="ActionButton" Style="{StaticResource DialButton}" Width="168" Height="168" IsEnabled="False" AutomationProperties.Name="开始加速" Click="Action_Click">
         <Grid>
          <StackPanel x:Name="DialIdle"><local:Glyph x:Name="DialBolt" Data="{StaticResource IconBolt}" Filled="True" IconSize="38" Ink="{StaticResource TextTertiary}" HorizontalAlignment="Center"/><TextBlock x:Name="DialStartText" Text="开始加速" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel>
          <StackPanel x:Name="DialBusy" Visibility="Collapsed"><TextBlock x:Name="DialBusyTitle" Text="正在连接" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="DialBusyText" Text="" Style="{StaticResource Caption}" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
          <StackPanel x:Name="DialLive" Visibility="Collapsed"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock x:Name="DialLatency" Text="—" Style="{StaticResource Number}" FontSize="48"/><TextBlock Text="ms" Style="{StaticResource Meta}" FontSize="15" Margin="4,0,0,9" VerticalAlignment="Bottom"/></StackPanel><TextBlock x:Name="DialLiveText" Text="当前延迟" Style="{StaticResource Caption}" HorizontalAlignment="Center"/></StackPanel>
         </Grid>
        </Button>
       </Grid>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0"><Ellipse x:Name="StateDot" Width="8" Height="8" Fill="{StaticResource TextTertiary}" VerticalAlignment="Center"/><TextBlock x:Name="ConnectionState" AutomationProperties.AutomationId="ConnectionState" Text="未加速" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
       <TextBlock x:Name="InlineError" AutomationProperties.AutomationId="InlineError" Text="" Foreground="{StaticResource Bad}" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
       <StackPanel x:Name="Summary" Margin="0,20,0,0">
        <Border Height="1" Background="{StaticResource Border}" Margin="0,0,0,14"/>
        <Grid Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><local:Glyph Data="{StaticResource IconPin}" IconSize="15" Ink="{StaticResource TextTertiary}" VerticalAlignment="Center"/><TextBlock Text="区服" Style="{StaticResource Meta}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="SummaryRegion" Text="—" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        <Grid><StackPanel Orientation="Horizontal"><local:Glyph Data="{StaticResource IconRoute}" IconSize="15" Ink="{StaticResource TextTertiary}" VerticalAlignment="Center"/><TextBlock Text="线路" Style="{StaticResource Meta}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="SummaryLine" Text="—" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="190" TextTrimming="CharacterEllipsis"/></Grid>
       </StackPanel>
       <Button x:Name="StopButton" Content="停止加速" MinHeight="42" Margin="0,22,0,0" Visibility="Collapsed" Click="Stop_Click"/>
      </StackPanel></Border>
     </Grid>
    </ScrollViewer>
   </Grid>

   <!-- Nothing to do yet: why, and what would change that. -->
   <StackPanel x:Name="EmptyPane" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="40,0,40,40" Visibility="Collapsed">
    <Grid Width="132" Height="132" HorizontalAlignment="Center">
     <Ellipse Fill="{StaticResource Surface}"/>
     <Ellipse Margin="16" Stroke="{StaticResource Border}" StrokeThickness="1.5"/>
     <Path Data="{StaticResource BrandMark}" Fill="{StaticResource Accent}" Width="26" Height="16" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,6,0"/>
     <local:Glyph x:Name="EmptyGlyph" Data="{StaticResource IconPlug}" IconSize="46" Thickness="1.6" Ink="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <TextBlock x:Name="EmptyTitle" Text="正在连接本地服务" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" Margin="0,22,0,0"/>
    <TextBlock x:Name="EmptyText" Text="" Style="{StaticResource Meta}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
    <Button x:Name="EmptyAction" Content="登录账号" Style="{StaticResource Primary}" HorizontalAlignment="Center" MinWidth="168" Margin="0,24,0,0" Visibility="Collapsed" Click="EmptyAction_Click"/>
   </StackPanel>
  </Grid>

  <!-- Transient feedback, bottom right. -->
  <Border x:Name="Toast" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24" MaxWidth="460" Background="{StaticResource Elevated}" CornerRadius="10" Padding="12,10,18,10" Visibility="Collapsed" Effect="{StaticResource Shadow}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="ToastBadge" Width="28" Height="28" CornerRadius="14" Background="{StaticResource InfoSoft}" VerticalAlignment="Center"><local:Glyph x:Name="ToastGlyph" Data="{StaticResource IconInfo}" IconSize="17" Ink="{StaticResource Info}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <TextBlock Grid.Column="1" x:Name="Notice" AutomationProperties.AutomationId="Toast" Text="" TextWrapping="Wrap" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
   </Grid>
  </Border>

  <!-- Account menu beside the avatar; the transparent overlay closes it. -->
  <Grid x:Name="MenuOverlay" Grid.ColumnSpan="2" Background="Transparent" Visibility="Collapsed" PreviewMouseDown="MenuOverlay_MouseDown">
   <Border x:Name="MenuPanel" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="84,0,0,16" Width="248" Background="{StaticResource Elevated}" CornerRadius="10" Padding="6" Effect="{StaticResource Shadow}"><StackPanel>
    <Grid Margin="10,10,10,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid Width="38" Height="38"><Ellipse Fill="{StaticResource AccentSoft}"/><TextBlock x:Name="MenuInitial" Text="" Style="{StaticResource Number}" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
     <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="MenuAccount" Text="" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
    </Grid>
    <Border Height="1" Background="{StaticResource Border}" Margin="4,0,4,6"/>
    <Button Style="{StaticResource Ghost}" AutomationProperties.Name="切换账号" Click="Switch_Click"><StackPanel Orientation="Horizontal"><local:Glyph Data="{StaticResource IconSwap}" IconSize="17" Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/><TextBlock Text="切换账号" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
    <Button x:Name="LogoutButton" Style="{StaticResource Ghost}" AutomationProperties.Name="退出登录" Click="Logout_Click"><StackPanel Orientation="Horizontal"><local:Glyph Data="{StaticResource IconLogout}" IconSize="17" Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/><TextBlock Text="退出登录" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
    <Button Style="{StaticResource Ghost}" AutomationProperties.Name="连接诊断" Click="Diagnostics_Click"><StackPanel Orientation="Horizontal"><local:Glyph Data="{StaticResource IconPulse}" IconSize="17" Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/><TextBlock Text="复制连接诊断" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
    <Button x:Name="MenuUpdate" Style="{StaticResource Ghost}" AutomationProperties.Name="检查更新" Click="MenuUpdate_Click"><StackPanel Orientation="Horizontal"><local:Glyph Data="{StaticResource IconDownload}" IconSize="17" Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/><TextBlock x:Name="MenuUpdateText" Text="检查更新" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
    <Border Height="1" Background="{StaticResource Border}" Margin="4,6,4,6"/>
    <Button Style="{StaticResource Ghost}" AutomationProperties.Name="退出流光加速器" ToolTip="停止加速并关闭客户端" Click="Exit_Click"><StackPanel Orientation="Horizontal"><local:Glyph Data="{StaticResource IconPower}" IconSize="17" Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/><TextBlock Text="退出流光加速器" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
    <TextBlock x:Name="VersionLabel" Text="" Style="{StaticResource Caption}" FontFamily="{StaticResource DataFont}" Margin="10,8,10,6"/>
   </StackPanel></Border>
  </Grid>

  <!-- Sign-in dialog: brand art beside the form. -->
  <Border x:Name="LoginOverlay" Grid.ColumnSpan="2" Background="#E00D0C10" Visibility="Collapsed">
   <Border Background="{StaticResource Surface}" CornerRadius="14" Width="740" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8" Effect="{StaticResource Shadow}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid>
      <local:GameCover Seed="flowlight-brand" Hue="38" Night="True" Radius="10"/>
      <StackPanel Margin="28,30,24,0" VerticalAlignment="Top">
       <Path Data="{StaticResource BrandMark}" Fill="White" Width="34" Height="21" Stretch="Uniform" HorizontalAlignment="Left"/>
       <TextBlock Text="流光加速器" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,16,0,0"/>
       <TextBlock Text="选好线路，一键加速" FontSize="13.5" Foreground="#E6FFFFFF" Margin="0,6,0,0"/>
      </StackPanel>
      <StackPanel Margin="28,0,24,30" VerticalAlignment="Bottom">
       <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Border Width="30" Height="30" CornerRadius="15" Background="#33FFFFFF"><local:Glyph Data="{StaticResource IconGrid}" IconSize="16" Ink="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="游戏、区服一目了然" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Border Width="30" Height="30" CornerRadius="15" Background="#33FFFFFF"><local:SignalBars Level="4" Ink="White" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><local:SignalBars.RenderTransform><ScaleTransform ScaleX="0.72" ScaleY="0.72"/></local:SignalBars.RenderTransform></local:SignalBars></Border><TextBlock Text="线路延迟与负载看得见" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
       <StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="15" Background="#33FFFFFF"><local:Glyph Data="{StaticResource IconBolt}" Filled="True" IconSize="15" Ink="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="一键开始，随时停止" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
      </StackPanel>
     </Grid>
     <Grid Grid.Column="1" Margin="36,22,32,18">
      <Button Style="{StaticResource IconButton}" AutomationProperties.Name="关闭" ToolTip="关闭" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-16,0" Click="LoginCancel_Click"><local:Glyph Data="{StaticResource IconClose}" IconSize="16" Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
      <StackPanel VerticalAlignment="Center">
       <TextBlock x:Name="LoginTitle" Text="登录" Style="{StaticResource PageTitle}" FontSize="24"/>
       <TextBlock x:Name="LoginSubtitle" Text="" Style="{StaticResource Meta}" Margin="0,6,0,0" Visibility="Collapsed"/>
       <TextBlock Text="账号" Style="{StaticResource FieldLabel}" Margin="0,24,0,6"/><TextBox x:Name="Username" AutomationProperties.Name="账号"/>
       <TextBlock Text="密码" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/><PasswordBox x:Name="Password" AutomationProperties.Name="密码"/>
       <TextBlock x:Name="LoginError" TextWrapping="Wrap" Foreground="{StaticResource Bad}" FontSize="12.5" Margin="0,10,0,0"/>
       <Button x:Name="LoginButton" Content="登录" Style="{StaticResource Primary}" IsDefault="True" Margin="0,16,0,0" Click="Login_Click"/>
       <Button Content="稍后登录" Style="{StaticResource Ghost}" HorizontalContentAlignment="Center" IsCancel="True" Margin="0,6,0,0" Click="LoginCancel_Click"/>
       <TextBlock Text="没有账号？请联系客服开通。" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,12,0,0"/>
      </StackPanel>
     </Grid>
    </Grid>
   </Border>
  </Border>
 </Grid>
</Window>
