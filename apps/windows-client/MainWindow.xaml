<Window x:Class="FlowLight.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="流光加速器 · FlowLight Accelerator" Width="1120" Height="750" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#0C121C">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#111926" BorderBrush="#263142" BorderThickness="0,0,1,0"><DockPanel Margin="22,32,22,20">
   <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal"><Border Background="#29BDCF" CornerRadius="7" Width="35" Height="39"><TextBlock Text="F" Foreground="#08151A" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="FlowLight" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="ACCELERATOR" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></StackPanel><TextBlock Text="流光加速器" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,30,0,18"/><Button Content="游戏库" Background="#1E3943" HorizontalContentAlignment="Left" Click="Library_Click"/><Button x:Name="RefreshButton" Content="刷新游戏与线路" Margin="0,10,0,0" Click="Refresh_Click"/><Button Content="连接诊断" Margin="0,10,0,0" Click="Diagnostics_Click"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="AccountLabel" Text="尚未登录" FontSize="13" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/><Button Content="账号登录" Click="Account_Click"/><Button Content="退出并停止加速" Margin="0,10,0,0" FontSize="12" Click="Exit_Click"/><TextBlock x:Name="VersionLabel" Text="Windows x64" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,20,0,0"/></StackPanel><Grid/>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="36,32,36,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock Text="选好线路，准备开局。" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="选择游戏与区服，使用经过验证的加速线路。" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel><Border Background="#172431" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,6"><TextBlock x:Name="ServiceLabel" Text="检测本地服务…" FontSize="11" Foreground="{StaticResource Muted}"/></Border></Grid>
   <Border Grid.Row="1" x:Name="NoticeBox" Background="#34291E" CornerRadius="7" Margin="0,16,0,0" Padding="14,10"><TextBlock x:Name="Notice" Text="请登录后查看游戏与线路。首次使用需要安装本地服务。" TextWrapping="Wrap" Foreground="#E9C9A0" FontSize="12"/></Border>
   <Grid Grid.Row="2" Margin="0,20,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,24,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="我的游戏" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/><ListBox Grid.Row="1" x:Name="GameList" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" SelectionChanged="Game_Changed" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="card" Background="#151F2E" BorderBrush="#29374A" BorderThickness="1" CornerRadius="9" Padding="20"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="#38C9DB"/><Setter TargetName="card" Property="Background" Value="#18333D"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Opacity" Value=".9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid MinHeight="86"><StackPanel><TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding RuleLabel}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel><Path Data="M 0 5 L 14 5 M 9 0 L 14 5 L 9 10" Stroke="#40CDDC" StrokeThickness="1.5" Width="16" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox><TextBlock Grid.Row="1" x:Name="EmptyGames" VerticalAlignment="Top" IsHitTestVisible="False" Text="登录后将从服务端加载游戏目录。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/></Grid>
    <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="#283548" BorderThickness="1" CornerRadius="9" Padding="20"><DockPanel><StackPanel DockPanel.Dock="Bottom"><Button x:Name="StartButton" Content="开始加速" IsEnabled="False" Background="#31C5D7" Foreground="#07181C" FontWeight="SemiBold" Margin="0,14,0,0" Click="Start_Click"/><Button x:Name="StopButton" Content="停止加速" IsEnabled="False" Margin="0,10,0,0" Click="Stop_Click"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="本次连接" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="游戏区服" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,8"/><ComboBox x:Name="RegionList" SelectionChanged="Region_Changed"/><TextBlock Text="加速线路" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,8"/><ComboBox x:Name="LineList" SelectionChanged="Line_Changed"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock x:Name="LineHint" Text="请选择游戏与区服" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/><Border BorderBrush="#2B3748" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0"><StackPanel><TextBlock x:Name="ProbeTitle" Text="线路历史探测" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Latency" Text="—" FontSize="28" Margin="0,4,0,0"/><TextBlock Text="此数值不等同于游戏内延迟" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></DockPanel></Border>
   </Grid>
   <Border Grid.Row="3" BorderBrush="#243044" BorderThickness="0,1,0,0" Padding="0,18,0,0"><Grid><TextBlock x:Name="ConnectionState" Text="未连接" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ExitAddress" Text="游戏与线路由服务端配置" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Muted}"/></Grid></Border>
  </Grid>
  <Border x:Name="LoginOverlay" Grid.ColumnSpan="2" Background="#DB090F18" Visibility="Collapsed"><Border Background="#172130" BorderBrush="#354359" BorderThickness="1" CornerRadius="12" Padding="32" Width="390" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="登录流光加速器" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="使用平台账号获取游戏与线路授权。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,24"/><TextBlock Text="账号" Margin="0,0,0,8" FontSize="12"/><TextBox x:Name="Username" AutomationProperties.Name="账号"/><TextBlock Text="密码" Margin="0,18,0,8" FontSize="12"/><PasswordBox x:Name="Password" AutomationProperties.Name="密码"/><TextBlock x:Name="LoginError" TextWrapping="Wrap" Foreground="#FFB7A0" FontSize="12" Margin="0,12,0,0"/><Button x:Name="LoginButton" Content="登录" IsDefault="True" Background="#31C5D7" Foreground="#07181C" Margin="0,22,0,0" Click="Login_Click"/><Button Content="返回" IsCancel="True" Margin="0,10,0,0" Click="LoginCancel_Click"/></StackPanel></Border></Border>
 </Grid>
</Window>
