<Application x:Class="FlowLight.Client.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FlowLight.Client" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <!--
   Design plan. 流光加速器 sits beside a running game, usually at night, so
   the client is dark by choice: warm graphite neutrals with a slight violet
   bias and one amber accent, "流光金", reserved for the accelerate dial, the
   primary action and selection. Semantic colours (good / warn / bad / info)
   carry latency quality and state, separate from the accent. Pictures do
   the explaining: generated cover art per game, outline icons from one
   24 px grid, signal bars, a round dial and a latency chart. Type is
   Microsoft YaHei UI for the interface and Bahnschrift for numbers.
  -->
  <SolidColorBrush x:Key="Bg" Color="#131217"/>
  <SolidColorBrush x:Key="Sidebar" Color="#0D0C10"/>
  <SolidColorBrush x:Key="Surface" Color="#1B1A21"/>
  <SolidColorBrush x:Key="Elevated" Color="#23212A"/>
  <SolidColorBrush x:Key="Hover" Color="#2B2833"/>
  <SolidColorBrush x:Key="Border" Color="#2F2C38"/>
  <SolidColorBrush x:Key="BorderStrong" Color="#3D3948"/>
  <SolidColorBrush x:Key="Text" Color="#F3F0F6"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#B3ADBE"/>
  <SolidColorBrush x:Key="TextTertiary" Color="#948E9E"/>
  <SolidColorBrush x:Key="Muted" Color="#B3ADBE"/>
  <SolidColorBrush x:Key="Accent" Color="#E6AE45"/>
  <SolidColorBrush x:Key="AccentHover" Color="#F0BD5C"/>
  <SolidColorBrush x:Key="AccentPressed" Color="#D39D36"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#2C2518"/>
  <SolidColorBrush x:Key="AccentRing" Color="#59E6AE45"/>
  <SolidColorBrush x:Key="OnAccent" Color="#1C1300"/>
  <SolidColorBrush x:Key="Good" Color="#5CC98B"/>
  <SolidColorBrush x:Key="GoodSoft" Color="#245CC98B"/>
  <SolidColorBrush x:Key="Warn" Color="#EE9A3C"/>
  <SolidColorBrush x:Key="WarnSoft" Color="#24EE9A3C"/>
  <SolidColorBrush x:Key="Bad" Color="#E4606A"/>
  <SolidColorBrush x:Key="BadSoft" Color="#24E4606A"/>
  <SolidColorBrush x:Key="Info" Color="#7AA6E8"/>
  <SolidColorBrush x:Key="InfoSoft" Color="#247AA6E8"/>
  <SolidColorBrush x:Key="Scrim" Color="#99000000"/>
  <LinearGradientBrush x:Key="AccentFill" StartPoint="0.15,0" EndPoint="0.85,1"><GradientStop Color="#F7CB72" Offset="0"/><GradientStop Color="#E6AE45" Offset="0.55"/><GradientStop Color="#CC8C2B" Offset="1"/></LinearGradientBrush>
  <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI, Microsoft YaHei</FontFamily>
  <FontFamily x:Key="DataFont">Bahnschrift, Segoe UI Semibold, Microsoft YaHei UI</FontFamily>
  <DropShadowEffect x:Key="Shadow" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.5" Color="#000000"/>

  <!-- Icons, all drawn on the same 24 px grid with one stroke weight. -->
  <StreamGeometry x:Key="BrandMark">M0,1 L16,1 L13,3.2 L2,3.2 Z M4,6 L22,6 L19,8.2 L6,8.2 Z M0,11 L12,11 L9,13.2 L2,13.2 Z</StreamGeometry>
  <StreamGeometry x:Key="IconGrid">M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z</StreamGeometry>
  <StreamGeometry x:Key="IconBolt">M13,2 L4,14 H11 L10,22 L20,9.5 H13 Z</StreamGeometry>
  <StreamGeometry x:Key="IconSearch">M4.5,11 A6.5,6.5 0 1 1 17.5,11 A6.5,6.5 0 1 1 4.5,11 Z M15.8,15.8 L20.5,20.5</StreamGeometry>
  <StreamGeometry x:Key="IconRefresh">M20,12 A8,8 0 1 1 12,4 C14.2,4 16.2,4.9 17.7,6.3 L20,8.5 M20,3.5 V8.5 H15</StreamGeometry>
  <StreamGeometry x:Key="IconDownload">M12,3.5 V15 M7,10.5 L12,15.5 L17,10.5 M4.5,20 H19.5</StreamGeometry>
  <StreamGeometry x:Key="IconUser">M8,8 A4,4 0 1 1 16,8 A4,4 0 1 1 8,8 Z M4,21 C4,16.6 7.6,14 12,14 C16.4,14 20,16.6 20,21</StreamGeometry>
  <StreamGeometry x:Key="IconSwap">M7,7 H20 M16,3 L20,7 L16,11 M17,17 H4 M8,13 L4,17 L8,21</StreamGeometry>
  <StreamGeometry x:Key="IconLogout">M9,21 H5 A1,1 0 0 1 4,20 V4 A1,1 0 0 1 5,3 H9 M16,17 L21,12 L16,7 M21,12 H9</StreamGeometry>
  <StreamGeometry x:Key="IconPulse">M3,12 H7 L10,5 L14,19 L17,12 H21</StreamGeometry>
  <StreamGeometry x:Key="IconPower">M12,3 V12 M6.34,6.34 A8,8 0 1 0 17.66,6.34</StreamGeometry>
  <StreamGeometry x:Key="IconGlobe">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M3,12 H21 M12,3 C9.5,5.5 8.5,8.5 8.5,12 C8.5,15.5 9.5,18.5 12,21 C14.5,18.5 15.5,15.5 15.5,12 C15.5,8.5 14.5,5.5 12,3</StreamGeometry>
  <StreamGeometry x:Key="IconPin">M12,21 C12,21 5,14.5 5,9.5 A7,7 0 0 1 19,9.5 C19,14.5 12,21 12,21 Z M9.5,9.5 A2.5,2.5 0 1 1 14.5,9.5 A2.5,2.5 0 1 1 9.5,9.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconRoute">M2.5,17 A2,2 0 1 1 6.5,17 A2,2 0 1 1 2.5,17 Z M17.5,5 A2,2 0 1 1 21.5,5 A2,2 0 1 1 17.5,5 Z M6.5,17 H14.5 A3,3 0 0 0 14.5,11 H9.5 A3,3 0 0 1 9.5,5 H17.5</StreamGeometry>
  <StreamGeometry x:Key="IconGauge">M4,17 A8,8 0 1 1 20,17 M12,17 L15.5,11.5</StreamGeometry>
  <StreamGeometry x:Key="IconWave">M3,12 C5,7 7,7 9,12 C11,17 13,17 15,12 C17,7 19,7 21,12</StreamGeometry>
  <StreamGeometry x:Key="IconPacket">M4,7.5 L12,3.5 L20,7.5 V16.5 L12,20.5 L4,16.5 Z M4,7.5 L12,11.5 L20,7.5 M12,11.5 V20.5</StreamGeometry>
  <StreamGeometry x:Key="IconClock">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M12,7 V12 L15.5,14</StreamGeometry>
  <StreamGeometry x:Key="IconBack">M15,5 L8,12 L15,19</StreamGeometry>
  <StreamGeometry x:Key="IconCheck">M5,12.5 L10,17 L19,7</StreamGeometry>
  <StreamGeometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</StreamGeometry>
  <StreamGeometry x:Key="IconInfo">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M12,11 V16.5 M12,7.6 V7.7</StreamGeometry>
  <StreamGeometry x:Key="IconAlert">M12,3.5 L21.5,20 H2.5 Z M12,10 V14 M12,17 V17.1</StreamGeometry>
  <StreamGeometry x:Key="IconError">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M9,9 L15,15 M15,9 L9,15</StreamGeometry>
  <StreamGeometry x:Key="IconPlug">M9,2.5 V6.5 M15,2.5 V6.5 M6,6.5 H18 V10 A6,6 0 0 1 6,10 Z M12,16 V21.5</StreamGeometry>
  <StreamGeometry x:Key="IconGamepad">M7,8 H17 A4.5,4.5 0 0 1 21.5,12.5 V15.5 A3,3 0 0 1 16.2,17.4 L15,16 H9 L7.8,17.4 A3,3 0 0 1 2.5,15.5 V12.5 A4.5,4.5 0 0 1 7,8 Z M7.5,10.8 V14.2 M5.8,12.5 H9.2 M15.5,11.5 V11.6 M17.8,13.6 V13.7</StreamGeometry>

  <!-- Text colour, face and size are inherited from the window; an implicit
       TextBlock style would also reach the text inside button templates and
       override each button's own foreground. -->
  <Style TargetType="TextBlock"/>
  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{StaticResource TextTertiary}"/></Style>
  <Style x:Key="Meta" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Number" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontFamily" Value="{StaticResource DataFont}"/></Style>
  <!-- Shown over the search box while it is empty. -->
  <Style x:Key="SearchPlaceholder" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource TextTertiary}"/><Setter Property="FontSize" Value="13"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>

  <!-- Surfaces: tone, not outlines, tells them apart. -->
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="CornerRadius" Value="12"/></Style>
  <Style x:Key="Tile" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16,14"/></Style>

  <!-- Keyboard navigation draws the ring; a mouse click leaves nothing behind. -->
  <Style x:Key="FocusRing"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border BorderBrush="{StaticResource Accent}" BorderThickness="1.5" CornerRadius="8" Margin="-2"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="RoundFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Ellipse Stroke="{StaticResource Accent}" StrokeThickness="1.5" Margin="-5"/></ControlTemplate></Setter.Value></Setter></Style>

  <Style TargetType="Button">
   <Setter Property="Background" Value="{StaticResource Elevated}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="{StaticResource Hover}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Background" Value="{StaticResource Surface}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource OnAccent}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="42"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="{StaticResource AccentHover}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Background" Value="{StaticResource AccentPressed}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Background" Value="{StaticResource Elevated}"/><Setter Property="Foreground" Value="{StaticResource TextTertiary}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- List-like actions in menus. -->
  <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="10,7"/><Setter Property="MinHeight" Value="34"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="{StaticResource Hover}"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Background" Value="{StaticResource Elevated}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Ghost}"><Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
  <!-- Translucent pill laid over cover art. -->
  <Style x:Key="OnArt" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#8C0D0C10"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10,5,14,5"/><Setter Property="MinHeight" Value="30"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#CC0D0C10"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- The round accelerate button; its fill and content are set per state from code. -->
  <Style x:Key="DialButton" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource RoundFocus}"/><Setter Property="Background" Value="{StaticResource Elevated}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid><Ellipse Fill="{TemplateBinding Background}"/><Ellipse x:Name="sheen" Fill="White" Opacity="0"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="sheen" Property="Opacity" Value=".1"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="sheen" Property="Fill" Value="Black"/><Setter TargetName="sheen" Property="Opacity" Value=".12"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="sheen" Property="Opacity" Value="0"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="AvatarButton" TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource RoundFocus}"/><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid><Ellipse x:Name="disc" Fill="{StaticResource AccentSoft}"/><Ellipse x:Name="ring" Stroke="{StaticResource AccentRing}" StrokeThickness="1"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ring" Property="Stroke" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Rail navigation: icon over label. -->
  <Style x:Key="NavItem" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="GroupName" Value="nav"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Grid Width="60" Height="60"><Border x:Name="bg" CornerRadius="12" Background="Transparent"/><Border x:Name="bar" Width="3" Height="22" CornerRadius="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" Margin="-8,0,0,0" Visibility="Collapsed"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{StaticResource Hover}"/><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="bg" Property="Background" Value="{StaticResource Elevated}"/><Setter TargetName="bar" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Region choice: a badge and a name, ticked when chosen. -->
  <Style x:Key="RegionTile" TargetType="ListBoxItem">
   <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Grid><Border x:Name="tile" Width="128" Height="62" CornerRadius="10" Background="{StaticResource Surface}" BorderBrush="Transparent" BorderThickness="1.5" Padding="12,0"><ContentPresenter VerticalAlignment="Center"/></Border>
     <Border x:Name="tick" Width="18" Height="18" CornerRadius="9" Background="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Visibility="Collapsed"><local:Glyph Data="{StaticResource IconCheck}" IconSize="12" Thickness="2.8" Ink="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tile" Property="Background" Value="{StaticResource Elevated}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="tile" Property="Background" Value="{StaticResource AccentSoft}"/><Setter TargetName="tick" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Line choice: a row with a radio mark; unavailable lines cannot be picked. -->
  <Style x:Key="LineRow" TargetType="ListBoxItem">
   <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="IsEnabled" Value="{Binding Selectable}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="row" MinHeight="60" CornerRadius="10" Background="{StaticResource Surface}" BorderBrush="Transparent" BorderThickness="1.5" Padding="16,8">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ContentPresenter VerticalAlignment="Center"/>
      <Grid Grid.Column="1" Width="18" Height="18" Margin="18,0,0,0" VerticalAlignment="Center"><Ellipse x:Name="radio" Stroke="{StaticResource BorderStrong}" StrokeThickness="1.5"/><Ellipse x:Name="dot" Margin="4.5" Fill="{StaticResource Accent}" Visibility="Collapsed"/></Grid>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{StaticResource Elevated}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="row" Property="Background" Value="{StaticResource AccentSoft}"/><Setter TargetName="radio" Property="Stroke" Value="{StaticResource Accent}"/><Setter TargetName="dot" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{StaticResource Elevated}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,0"/><Setter Property="MinHeight" Value="40"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/><Setter Property="SelectionBrush" Value="{StaticResource Accent}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderStrong}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="Background" Value="{StaticResource Elevated}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,0"/><Setter Property="MinHeight" Value="40"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/><Setter Property="SelectionBrush" Value="{StaticResource Accent}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderStrong}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ToolTip"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="FontSize" Value="12"/><Setter Property="HasDropShadow" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{StaticResource Elevated}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="4" Padding="9,5"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>

  <!-- The stock ListBox paints itself white when disabled; a locked list only dims. -->
  <Style TargetType="ListBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border x:Name="host" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ScrollViewer Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"><ItemsPresenter/></ScrollViewer></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="host" Property="Opacity" Value=".6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <!-- Lists inside a page scroll with the page. -->
