  "narrative": {
    "northStar": "Operate",
    "overview": "FlowLight uses light operational tables for administrators and a dark game library with a connection panel for Windows players. Cyan identifies actions and selection. This record merges the confirmed incumbent direction with the implemented React administration and native WPF client; it does not introduce a new visual concept.\n\nDense resource views, plain language, and visible connection evidence support the initial VALORANT and League of Legends workflow. Game names and simple vector icons provide recognition; no game artwork is bundled.",
    "keyCharacteristics": [
      "Light administration, dark native client, cyan actions.",
      "Persistent navigation, compact resource tables, modal editors.",
      "Game selection beside one connection panel and its start action.",
      "Unknown, draft, unavailable, historical, and current states remain explicit."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "A color or count must describe reported state: an enabled resource, a published profile, a verified path, and a live connection are separate facts.",
        "section": "colors"
      },
      {
        "name": "The Probe Label Rule",
        "body": "Historical line measurements are labeled “线路历史探测”; current tunnel evidence is labeled “当前隧道探测”. Missing evidence displays an em dash, and service loss clears stale measurements. Neither measurement is presented as in-game latency.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** preserve the light administration and dark native-client surface roles.",
      "**Do** keep status labels, provenance, empty states, and errors visible beside the affected resource or action.",
      "**Do** retain horizontally scrollable tables on narrow web screens and scrollable connection details at the native minimum size.",
      "**Do** use local Chinese-capable fonts and simple vector icons already present in the applications."
    ],
    "donts": [
      "**Don't** replace unknown counts or missing probe evidence with zero or invented healthy measurements.",
      "**Don't** conflate a published rule, verified path, historical probe, and current connection.",
      "**Don't** claim tested game compatibility or bundle proprietary game artwork without established evidence or assets."
    ]
  }
}
